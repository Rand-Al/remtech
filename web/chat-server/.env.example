# Адрес OpenAI-совместимого API (LM Studio: http://localhost:1234/v1)
RT_LLM_BASE_URL=http://localhost:1234/v1
# Ключ (для LM Studio не нужен; для DeepSeek/OpenAI — свой)
RT_LLM_API_KEY=
# Имя модели (в LM Studio можно любое, напр. локальная модель)
RT_LLM_MODEL=local-model
# Для гибридных Qwen: false ускоряет обычный разговорный чат
RT_LLM_ENABLE_THINKING=
# Резервные модели через запятую (OpenRouter попробует их по порядку)
RT_LLM_FALLBACK_MODELS=
# Таймаут запроса в мс
RT_LLM_TIMEOUT_MS=120000
# Максимальное ожидание одной модели перед переходом к резервной
RT_LLM_ATTEMPT_TIMEOUT_MS=20000

# Порт сервера чата
RT_PORT=4100

# Локальное хранилище вложений (позже можно заменить адаптером MinIO)
RT_UPLOAD_DIR=data/uploads

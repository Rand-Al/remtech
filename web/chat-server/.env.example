# Эти переменные используются, только пока в админке (/admin, раздел LLM)
# не сохранены настройки провайдера: база приоритетнее env после первого сохранения.
# Адрес OpenAI-совместимого API (LM Studio: http://localhost:1234/v1)
RT_LLM_BASE_URL=http://localhost:1234/v1
# Ключ (для LM Studio не нужен; для DeepSeek/OpenAI — свой)
RT_LLM_API_KEY=
# Имя модели (в LM Studio можно любое, напр. локальная модель)
RT_LLM_MODEL=local-model
# Для гибридных Qwen: false ускоряет обычный разговорный чат
RT_LLM_ENABLE_THINKING=
# Резервные модели через запятую (OpenRouter попробует их по порядку)
RT_LLM_FALLBACK_MODELS=
# Таймаут запроса в мс
RT_LLM_TIMEOUT_MS=120000
# Максимальное ожидание одной модели перед переходом к резервной
RT_LLM_ATTEMPT_TIMEOUT_MS=20000

# Порт сервера чата
RT_PORT=4100

# Локальное хранилище вложений (позже можно заменить адаптером MinIO)
RT_UPLOAD_DIR=data/uploads

# Telegram Bot API. Если обе обязательные переменные пусты, используется stub.
RT_TELEGRAM_BOT_TOKEN=
RT_TELEGRAM_CHAT_ID=
# Необязательные ID тем супергруппы. Без них сообщения идут в общий чат.
RT_TELEGRAM_REQUESTS_THREAD_ID=
RT_TELEGRAM_TECHNICAL_THREAD_ID=
# Создавать отдельную тему для каждой заявки. Боту нужны права управления темами.
RT_TELEGRAM_PER_REQUEST_TOPICS=false
RT_TELEGRAM_TIMEOUT_MS=10000

# Антиспам: лимит сообщений на IP за 5 минут (чат и ответы менеджера)
RT_RATE_LIMIT_MESSAGES=30
# Антиспам: максимум новых заявок с одного IP за час
RT_RATE_LIMIT_NEW_REQUESTS=5
# За обратным прокси (nginx): брать адрес клиента из X-Forwarded-For
RT_TRUST_PROXY=false

# Пароль админки для /api/admin/settings
RT_ADMIN_PASSWORD=

{
  "name": "chat-server",
  "version": "1.0.0",
  "private": true,
  "description": "RemTech chat and request server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "telegram:chats": "tsx src/telegram/discover.ts",
    "telegram:test": "tsx src/telegram/test-connection.ts"
  },
  "dependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
